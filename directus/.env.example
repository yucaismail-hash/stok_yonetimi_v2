# Core
SECRET=
PUBLIC_URL=https://your-directus-service.onrender.com
PORT=8055

# Neon PostgreSQL (DIRECT connection only for bootstrap/runtime)
DB_CLIENT=pg
DB_CONNECTION_STRING=

# Initial bootstrap admin (remove from Render after first successful setup)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Browser access
CORS_ENABLED=true
CORS_ORIGIN=https://stokonomi.com,https://www.stokonomi.com,http://localhost:5173
CORS_CREDENTIALS=false

# Public API protection
RATE_LIMITER_ENABLED=true
RATE_LIMITER_POINTS=100
RATE_LIMITER_DURATION=1

# Realtime and telemetry
WEBSOCKETS_ENABLED=false
TELEMETRY=false
LOG_LEVEL=info

# Persistent media storage (S3-compatible object storage)
STORAGE_LOCATIONS=media
STORAGE_MEDIA_DRIVER=s3
STORAGE_MEDIA_KEY=
STORAGE_MEDIA_SECRET=
STORAGE_MEDIA_BUCKET=
STORAGE_MEDIA_REGION=
STORAGE_MEDIA_ENDPOINT=
STORAGE_MEDIA_FORCE_PATH_STYLE=false
STORAGE_MEDIA_SERVER_SIDE_ENCRYPTION=
