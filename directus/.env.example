# Stokonomi Directus configuration contract (secret-free)
#
# Production values are dashboard-owned. Never copy production credentials into
# this file. DATABASE_URL_CONTENT is intentionally not part of the Directus
# runtime contract; its owner remains UNKNOWN.

# Directus runtime
SECRET=replace-with-a-long-random-secret
PUBLIC_URL=https://cms.example.invalid
PORT=8055

# PostgreSQL content database
DB_CLIENT=pg
DB_CONNECTION_STRING=postgresql://directus_user:replace-me@directus-db:5432/directus_content

# One-time bootstrap only. Remove from an initialized production service after
# verifying the currently pinned Directus behavior.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password

# Browser/API boundary
CORS_ENABLED=true
CORS_ORIGIN=https://www.example.invalid
CORS_CREDENTIALS=false
RATE_LIMITER_ENABLED=true
RATE_LIMITER_POINTS=50
RATE_LIMITER_DURATION=1
WEBSOCKETS_ENABLED=false
TELEMETRY=false
LOG_LEVEL=info

# S3-compatible production media contract. The local reconstruction stack uses
# filesystem storage instead and does not require these values.
STORAGE_LOCATIONS=media
STORAGE_MEDIA_DRIVER=s3
STORAGE_MEDIA_KEY=replace-with-storage-access-key
STORAGE_MEDIA_SECRET=replace-with-storage-secret
STORAGE_MEDIA_BUCKET=replace-with-bucket-name
STORAGE_MEDIA_REGION=auto
STORAGE_MEDIA_ENDPOINT=https://storage.example.invalid
STORAGE_MEDIA_FORCE_PATH_STYLE=false
STORAGE_MEDIA_SERVER_SIDE_ENCRYPTION=
